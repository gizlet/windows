<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Gizlet.FlashHelper</AssemblyName>
    <RootNamespace>Gizlet.FlashHelper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- One native executable: no managed or runtime files beside it that a user could replace. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Gizlet.Windows/Gizlet.Windows.csproj" />
  </ItemGroup>
</Project>
